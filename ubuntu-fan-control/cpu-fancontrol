def read_value(path):
    with open(path) as f:
        return f.read().strip()


def write_value(path, value):
    with open(path, "w") as f:
        f.write(str(value))


def read_number(path, divisor=1):
    """Liest einen Zahlenwert, liefert None bei Fehlern."""
    try:
        return int(read_value(path)) / divisor
    except (OSError, ValueError):
        return None


def percent_to_raw(percent):
    return int(round(max(0.0, min(100.0, percent)) * PWM_MAX / 100))


def raw_to_percent(raw):
    return raw * 100.0 / PWM_MAX


def natural_key(text):
    return [int(part) if part.isdigit() else part for part in re.split(r"(\d+)", text)]


class Chip:
    """Ein hwmon-Gerät, z.B. /sys/class/hwmon/hwmon2 (coretemp)."""

    PATTERNS = {"temp": r"temp(\d+)_input", "fan": r"fan(\d+)_input", "pwm": r"pwm(\d+)"}

    def __init__(self, hwmon_dir, attr_dir):
        self.hwmon = hwmon_dir.name
        self.path = attr_dir
        self.name = read_value(attr_dir / "name")
        device = hwmon_dir / "device"
        self.device = os.path.basename(os.path.realpath(device)) if device.exists() else ""
        self.ident = self.name  # eindeutiger Bezeichner, siehe discover_chips()

    def numbers(self, kind):
        """Nummern der vorhandenen Attribute, z.B. numbers("temp") -> [1, 2, 3]."""
        pattern = re.compile(self.PATTERNS[kind])
        found = []
        for entry in self.path.iterdir():
            match = pattern.fullmatch(entry.name)
            if match:
                found.append(int(match.group(1)))
        return sorted(found)

    def attr_path(self, kind, num):
        return self.path / (f"pwm{num}" if kind == "pwm" else f"{kind}{num}_input")

    def label(self, kind, num):
        try:
            return read_value(self.path / f"{kind}{num}_label")
        except OSError:
            return ""


def discover_chips(root=None):
    """Findet alle hwmon-Geräte. Die hwmonN-Nummern können sich bei jedem
    Booten ändern, deshalb werden Geräte über ihren Namen angesprochen."""
    root = Path(root or HWMON_ROOT)
    chips = []
    if not root.is_dir():
        return chips
    for hwmon_dir in sorted(root.iterdir(), key=lambda p: natural_key(p.name)):
        if not hwmon_dir.name.startswith("hwmon"):
            continue
        # Ältere Treiber legen ihre Dateien unter device/ ab.
        for attr_dir in (hwmon_dir, hwmon_dir / "device"):
            if (attr_dir / "name").is_file():
                try:
                    chips.append(Chip(hwmon_dir, attr_dir))
                except OSError:
                    pass
                break
    # Gibt es einen Namen mehrfach (z.B. coretemp bei zwei CPUs), wird
    # stattdessen die Geräte-ID verwendet (z.B. coretemp.0 und coretemp.1).
    names = [chip.name for chip in chips]
    for chip in chips:
        if names.count(chip.name) > 1:
            chip.ident = chip.device or chip.hwmon
    return chips


def find_chip(chips, spec):
    for key in ("name", "device", "hwmon"):
        matches = [chip for chip in chips if getattr(chip, key) == spec]
        if len(matches) == 1:
            return matches[0]
        if len(matches) > 1:
            choices = ", ".join(chip.ident for chip in matches)
            raise FanControlError(f"Chip '{spec}' ist mehrdeutig – bitte eine dieser Geräte-IDs verwenden: {choices}")
    known = ", ".join(chip.ident for chip in chips) or "keine"
    raise DeviceNotFound(f"Chip '{spec}' nicht gefunden (vorhanden: {known}) – siehe 'cpu-fancontrol list'")


def resolve(chips, spec, kind):
    """Löst '<chip>/<kind>N' oder '<chip>/<Label>' auf und liefert (Name, Pfad)."""
    chip_spec, _, attr = spec.partition("/")
    chip_spec, attr = chip_spec.strip(), attr.strip()
    if not chip_spec or not attr:
        raise FanControlError(f"Ungültige Angabe '{spec}' – erwartet '<chip>/{kind}N', z.B. '{EXAMPLES[kind]}'")
    chip = find_chip(chips, chip_spec)
    suffix = "" if kind == "pwm" else "(?:_input)?"
    match = re.fullmatch(rf"{kind}(\d+){suffix}", attr)
    if match:
        num = int(match.group(1))
    else:
        labels = {chip.label(kind, n).lower(): n for n in chip.numbers(kind)}
        num = labels.get(attr.lower())
    if num is None or not chip.attr_path(kind, num).is_file():
        available = ", ".join(f"{kind}{n}" for n in chip.numbers(kind)) or "keine"
        raise DeviceNotFound(f"'{spec}' nicht gefunden (bei {chip.ident} vorhanden: {available})")
    return f"{chip.ident}/{kind}{num}", chip.attr_path(kind, num)


def auto_cpu_sensors(chips):
    """Sucht die CPU-Temperatur: Package-Temperatur (Intel) bzw. Tctl (AMD)."""
    sensors = []
    for chip in chips:
        if chip.name not in CPU_CHIPS:
            continue
        nums = chip.numbers("temp")
        labels = {n: chip.label("temp", n).lower() for n in nums}
        if chip.name == "coretemp":
            chosen = [n for n in nums if labels[n].startswith("package")]
        elif chip.name in ("k10temp", "zenpower"):
            chosen = [n for n in nums if labels[n] == "tctl"] or [n for n in nums if labels[n] == "tdie"]
        else:
            chosen = []
        for num in chosen or nums[:1]:
            sensors.append(Sensor(f"{chip.ident}/temp{num}", chip.attr_path("temp", num), 1000, TEMP_PLAUSIBLE))
    if not sensors:
        raise DeviceNotFound("Kein CPU-Temperatursensor gefunden (coretemp/k10temp) – Treiber geladen? "
                             "Alternativ den Sensor unter 'sensors' direkt angeben")
    return sensors


class Sensor:
    """Ein Temperatur- (°C) oder Drehzahlsensor (U/min)."""

    def __init__(self, name, path, divisor=1, plausible=None):
        self.name = name
        self.path = Path(path)
        self.divisor = divisor
        self.plausible = plausible

    def read(self):
        value = int(read_value(self.path)) / self.divisor
        if self.plausible and not self.plausible[0] <= value <= self.plausible[1]:
            raise ValueError(f"unplausibler Wert {value:g}")
        return value


class PwmOutput:
    """Ein PWM-Lüfterausgang (pwmN) samt Betriebsart (pwmN_enable)."""

    def __init__(self, name, path):
        self.name = name
        self.path = Path(path)
        self.enable_path = self.path.with_name(self.path.name + "_enable")

    def read(self):
        return int(read_value(self.path))

    def read_enable(self):
        """0 = volle Drehzahl, 1 = manuell, ab 2 = automatisch, None = nicht umschaltbar."""
        if not self.enable_path.exists():
            return None
        return int(read_value(self.enable_path))

    def set_enable(self, mode):
        write_value(self.enable_path, mode)

    def set_manual(self):
        """Schaltet auf manuelle Steuerung und liefert die vorherige Betriebsart."""
        mode = self.read_enable()
        if mode not in (None, 1):
            self.set_enable(1)
        return mode

    def write_percent(self, percent):
        write_value(self.path, percent_to_raw(percent))


