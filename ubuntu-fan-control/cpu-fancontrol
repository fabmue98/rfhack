class FanControlError(Exception):
    """Fehler, der ohne Traceback an den Benutzer gemeldet wird."""


class DeviceNotFound(FanControlError):
    """Ein konfigurierter Sensor oder PWM-Ausgang existiert (noch) nicht."""


