def parse_number(section, key, defaults, where, minimum, maximum):
    raw = str(section.get(key, defaults[key])).strip()
    try:
        value = float(raw)
    except ValueError:
        raise FanControlError(f"{where} {key}: '{raw}' ist keine Zahl")
    if not minimum <= value <= maximum:
        raise FanControlError(f"{where} {key}: {raw} liegt nicht zwischen {minimum:g} und {maximum:g}")
    return value


def parse_curve(text, where):
    """'40:25, 55:40, 80:100' -> [(40.0, 25.0), (55.0, 40.0), (80.0, 100.0)]"""
    points = []
    for part in text.split(","):
        cleaned = re.sub(r"[\s°%Cc]", "", part)
        if not cleaned:
            continue
        temp, sep, pwm = cleaned.partition(":")
        try:
            if not sep:
                raise ValueError
            points.append((float(temp), float(pwm)))
        except ValueError:
            raise FanControlError(f"{where} curve: '{part.strip()}' ist kein Punkt der Form Temperatur:Prozent (z.B. 50:40)")
    if not points:
        raise FanControlError(f"{where} curve: keine Punkte angegeben")
    for _, pwm in points:
        if not 0 <= pwm <= 100:
            raise FanControlError(f"{where} curve: Drehzahl {pwm:g} % liegt nicht zwischen 0 und 100")
    for (t0, p0), (t1, p1) in zip(points, points[1:]):
        if t1 <= t0:
            raise FanControlError(f"{where} curve: Temperaturen müssen aufsteigend sein ({t0:g} → {t1:g})")
        if p1 < p0:
            raise FanControlError(f"{where} curve: Drehzahl darf mit steigender Temperatur nicht sinken ({p0:g} % → {p1:g} %)")
    return points


def interpolate(curve, temp):
    """Drehzahl in % für eine Temperatur, linear zwischen den Kennlinienpunkten."""
    if temp <= curve[0][0]:
        return curve[0][1]
    for (t0, p0), (t1, p1) in zip(curve, curve[1:]):
        if temp <= t1:
            return p0 + (p1 - p0) * (temp - t0) / (t1 - t0)
    return curve[-1][1]


def check_keys(section, allowed, where):
    unknown = sorted(set(section) - set(allowed))
    if unknown:
        raise FanControlError(f"{where}: unbekannte Option(en): {', '.join(unknown)}")


def parse_fan(name, section):
    where = f"[fan:{name}]"
    check_keys(section, FAN_DEFAULTS, where)
    for key in ("pwm", "sensors"):
        if not section.get(key, "").strip():
            raise FanControlError(f"{where}: Option '{key}' fehlt")

    values = {key: parse_number(section, key, FAN_DEFAULTS, where, *limits) for key, limits in FAN_LIMITS.items()}
    if not values["average"].is_integer():
        raise FanControlError(f"{where} average: muss eine ganze Zahl sein")
    values["average"] = int(values["average"])
    return SimpleNamespace(
        name=name,
        pwm=section["pwm"].strip(),
        sensors=[s.strip() for s in section["sensors"].split(",") if s.strip()],
        fan=section.get("fan", "").strip(),
        curve=parse_curve(section.get("curve", FAN_DEFAULTS["curve"]), where),
        **values,
    )


def parse_bool(value, where):
    text = str(value).strip().lower()
    if text in ("1", "yes", "ja", "true", "on"):
        return True
    if text in ("0", "no", "nein", "false", "off"):
        return False
    raise FanControlError(f"{where}: '{value}' ist kein Ja/Nein-Wert (yes oder no)")


def parse_web(section):
    check_keys(section, WEB_DEFAULTS, "[web]")

    def get(key):
        return str(section.get(key, WEB_DEFAULTS[key])).strip()

    path = "/" + get("path").strip("/")
    if not re.fullmatch(r"/[A-Za-z0-9._~/-]*", path) or "//" in path:
        raise FanControlError(f"[web] path: '{get('path')}' ist ungültig (Beispiel: /fan)")
    password_hash = get("password_hash")
    if password_hash and not PASSWORD_HASH_RE.fullmatch(password_hash):
        raise FanControlError("[web] password_hash ist ungültig – neu setzen mit: sudo cpu-fancontrol passwd")
    if not get("listen"):
        raise FanControlError("[web] listen: Adresse fehlt (z.B. 127.0.0.1)")
    return SimpleNamespace(
        enabled=parse_bool(get("enabled"), "[web] enabled"),
        listen=get("listen"),
        port=int(parse_number(section, "port", WEB_DEFAULTS, "[web]", 1, 65535)),
        path="" if path == "/" else path,
        password_hash=password_hash,
    )


def load_config(path):
    parser = configparser.ConfigParser(inline_comment_prefixes=("#",), interpolation=None)
    try:
        with open(path, encoding="utf-8") as f:
            parser.read_file(f)
    except FileNotFoundError:
        raise FanControlError(f"Konfigurationsdatei {path} nicht gefunden")
    except (configparser.Error, UnicodeDecodeError) as exc:
        raise FanControlError(f"Fehler in {path}: {exc}")

    general = parser["general"] if parser.has_section("general") else {}
    check_keys(general, GENERAL_DEFAULTS, "[general]")
    on_exit = general.get("on_exit", GENERAL_DEFAULTS["on_exit"]).strip().lower()
    if on_exit not in ("restore", "full"):
        raise FanControlError(f"[general] on_exit: '{on_exit}' ist ungültig (erlaubt: restore, full)")
    config = SimpleNamespace(
        interval=parse_number(general, "interval", GENERAL_DEFAULTS, "[general]", 0.5, 60),
        on_exit=on_exit,
        web=parse_web(parser["web"] if parser.has_section("web") else {}),
        fans=[],
    )
    for section in parser.sections():
        if section in ("general", "web"):
            continue
        name = section[4:].strip() if section.startswith("fan:") else ""
        if not name:
            raise FanControlError(f"Unbekannter Abschnitt [{section}] – erlaubt sind [general] und [fan:<name>]")
        config.fans.append(parse_fan(name, parser[section]))
    if not config.fans:
        raise FanControlError(f"{path}: kein Lüfter konfiguriert (Abschnitt [fan:<name>] fehlt)")
    return config


def format_curve(curve):
    return ", ".join(f"{temp:g}:{pwm:g}" for temp, pwm in curve)


def fan_config_values(cfg):
    """Die Einstellungen eines Lüfters als Text, so wie sie in der Datei stehen."""
    values = {"pwm": cfg.pwm, "sensors": ", ".join(cfg.sensors), "fan": cfg.fan, "curve": format_curve(cfg.curve)}
    values.update({key: f"{getattr(cfg, key):g}" for key in FAN_LIMITS})
    return values


def _section_key(name):
    name = name.strip()
    return "fan:" + name[4:].strip() if name.startswith("fan:") else name


def write_file_atomic(path, text):
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    try:
        os.chmod(tmp, os.stat(path).st_mode & 0o7777)
    except FileNotFoundError:
        pass
    os.replace(tmp, path)


def update_config_file(path, section, values):
    """Ändert Optionen eines Abschnitts in der Konfigurationsdatei. Kommentare und
    alle übrigen Zeilen bleiben erhalten. Der Wert None entfernt eine Option."""
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    headers = [(i, re.fullmatch(r"\s*\[(.*)\]\s*", line)) for i, line in enumerate(lines)]
    headers = [(i, _section_key(match.group(1))) for i, match in headers if match]
    start = next((i for i, key in headers if key == _section_key(section)), None)
    if start is None:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(f"[{section}]")
        start = len(lines) - 1
    end = next((i for i, _ in headers if i > start), len(lines))

    for key, value in values.items():
        pattern = re.compile(rf"(\s*{re.escape(key)}\s*[=:]\s*)(.*?)(\s+#.*)?", re.IGNORECASE)
        for i in range(start + 1, end):
            match = pattern.fullmatch(lines[i])
            if not match:
                continue
            # Fortsetzungszeilen (eingerückt) gehören zum alten Wert
            j = i + 1
            while j < end and lines[j][:1] in (" ", "\t") and lines[j].strip():
                j += 1
            replacement = [] if value is None else [f"{key} = {value}{match.group(3) or ''}"]
            lines[i:j] = replacement
            end -= (j - i) - len(replacement)
            break
        else:
            if value is not None:
                # nach der letzten Option des Abschnitts einfügen
                insert = start + 1
                for i in range(start + 1, end):
                    if lines[i].strip() and not lines[i].lstrip().startswith(("#", ";")):
                        insert = i + 1
                lines.insert(insert, f"{key} = {value}")
                end += 1
    write_file_atomic(path, "\n".join(lines) + "\n")


