def fmt_temp(value):
    return "–" if value is None else f"{value:.1f} °C"


def fmt_rpm(value):
    return "–" if value is None else f"{int(value)} U/min"


def fmt_pwm(raw):
    return "–" if raw is None else f"{int(raw)} ({raw_to_percent(raw):.0f} %)"


def mode_text(mode):
    if mode is None:
        return "–"
    return {0: "0 (volle Drehzahl)", 1: "1 (manuell)"}.get(mode, f"{mode} (automatisch)")


def safe_mode(output):
    try:
        return output.read_enable()
    except (OSError, ValueError):
        return None


def cmd_list(args):
    chips = discover_chips()
    if not chips:
        print("Keine hwmon-Geräte gefunden.\n")
        print(DRIVER_HINT)
        return 1
    pwm_count = 0
    for chip in chips:
        device = f", Gerät {chip.device}" if chip.device and chip.device != chip.ident else ""
        print(f"{chip.ident}  ({chip.hwmon}{device})")
        rows = []
        for num in chip.numbers("temp"):
            rows.append((f"temp{num}", fmt_temp(read_number(chip.attr_path("temp", num), 1000)), chip.label("temp", num)))
        for num in chip.numbers("fan"):
            rows.append((f"fan{num}", fmt_rpm(read_number(chip.attr_path("fan", num))), chip.label("fan", num)))
        for num in chip.numbers("pwm"):
            output = PwmOutput("", chip.attr_path("pwm", num))
            rows.append((f"pwm{num}", fmt_pwm(read_number(output.path)), f"Betriebsart {mode_text(safe_mode(output))}"))
            pwm_count += 1
        for attr, value, info in rows:
            print(f"  {chip.ident + '/' + attr:<28} {value:>14}  {info}")
        print()
    if pwm_count:
        print("CPU-Lüfter finden:  sudo cpu-fancontrol test <chip>/pwmN")
    else:
        print("Es wurden keine PWM-Ausgänge gefunden.\n")
        print(DRIVER_HINT)
    return 0


def cmd_check(args):
    config = load_config(args.config)
    controllers = build_controllers(config, discover_chips())
    print(f"Konfiguration {args.config} ist gültig "
          f"(Intervall {config.interval:g} s, beim Beenden: {config.on_exit}).")
    for controller in controllers:
        cfg, output = controller.cfg, controller.output
        print(f"\n[fan:{controller.name}]")
        for sensor in controller.sensors:
            print(f"  Sensor     {sensor.name:<24} {fmt_temp(read_number(sensor.path, 1000))}")
        print(f"  PWM        {output.name:<24} {fmt_pwm(read_number(output.path))}, "
              f"Betriebsart {mode_text(safe_mode(output))}")
        if not os.access(output.path, os.W_OK):
            print("             (kein Schreibzugriff – der Dienst muss als root laufen)")
        if controller.fan_sensor:
            print(f"  Drehzahl   {controller.fan_sensor.name:<24} {fmt_rpm(read_number(controller.fan_sensor.path))}")
        print("  Kennlinie  " + ", ".join(f"{t:g} °C → {p:g} %" for t, p in cfg.curve))
        print(f"  Grenzen    min {cfg.min_pwm:g} %, Anlauf {cfg.start_pwm:g} %, "
              f"Hysterese {cfg.hysteresis:g} °C, kritisch ab {cfg.critical_temp:g} °C")
        print(f"  Sollwert   {controller.compute():.0f} % bei der aktuellen Temperatur")
    return 0


def cmd_run(args):
    config = load_config(args.config)
    if not args.dry_run:
        acquire_lock(args.state_file)
    controllers = wait_for_devices(config, 0 if args.dry_run else DEVICE_WAIT)

    stop = threading.Event()
    received = []

    def on_signal(signum, _frame):
        received.append(signum)
        stop.set()

    signals = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)
    for sig in signals:
        signal.signal(sig, on_signal)
    try:
        if not args.dry_run:
            take_control(controllers, config.on_exit, args.state_file)
        log.info("cpu-fancontrol %s gestartet%s – %s", VERSION,
                 " (Testlauf, es wird nichts geschrieben)" if args.dry_run else "",
                 "; ".join(c.describe() for c in controllers))
        while not stop.is_set():
            for controller in controllers:
                controller.step(args.dry_run)
            stop.wait(config.interval)
    finally:
        for sig in signals:
            signal.signal(sig, signal.SIG_IGN)
        if not args.dry_run:
            release_control(args.state_file)
    if received:
        log.info("Beendet (%s)", signal.Signals(received[0]).name)
    return 0


def cmd_restore(args):
    acquire_lock(args.state_file)
    result = release_control(args.state_file)
    if result is None:
        log.info("Nichts zurückzusetzen – es sind keine Lüfter übernommen")
        return 0
    return 0 if result else 1


def cmd_test(args):
    chips = discover_chips()
    name, path = resolve(chips, args.pwm, "pwm")
    output = PwmOutput(name, path)
    acquire_lock(args.state_file)
    fans = [(f"{c.ident}/fan{n}", c.attr_path("fan", n)) for c in chips for n in c.numbers("fan")]
    cpu_temps = [c.attr_path("temp", n) for c in chips if c.name in CPU_CHIPS for n in c.numbers("temp")]

    def cpu_temp():
        values = [v for v in (read_number(p, 1000) for p in cpu_temps) if v is not None]
        return max(values) if values else None

    def measure(percent):
        output.set_manual()
        output.write_percent(percent)
        for _ in range(args.delay):
            time.sleep(1)
            temp = cpu_temp()
            if temp is not None and temp >= args.max_temp:
                raise FanControlError(f"Abbruch: CPU-Temperatur {temp:.1f} °C hat --max-temp {args.max_temp:g} °C erreicht")
        return {fan: read_number(fan_path) for fan, fan_path in fans}

    def show(percent, rpms, columns):
        cells = "".join(f"{fmt_rpm(rpms[fan]):>16}" for fan in columns)
        temp = cpu_temp()
        print(f"{percent:>5} %{cells}   {fmt_temp(temp) if temp is not None else ''}", flush=True)

    original_pwm, original_mode = output.read(), output.read_enable()
    print(f"Teste {name}: die Drehzahl wird stufenweise von 100 % auf 0 % gesenkt ({args.delay} s je Stufe).")
    print("Abbruch mit Strg+C – der ursprüngliche Zustand wird danach wiederhergestellt.\n")
    down, up, columns, done = [], [], None, False
    try:
        for percent in TEST_STEPS:
            rpms = measure(percent)
            if columns is None:
                # Nur Lüfter anzeigen, die überhaupt drehen
                columns = [fan for fan, _ in fans if rpms[fan]] or [fan for fan, _ in fans]
                print("  PWM " + "".join(f"{fan:>16}" for fan in columns) + "   CPU")
            down.append((percent, rpms))
            show(percent, rpms, columns)
        stopped = [fan for fan in columns if down[0][1][fan] and not down[-1][1][fan]]
        if stopped:
            print("\nAnlauftest – ab welcher Drehzahl startet der Lüfter aus dem Stillstand?")
            for percent in range(10, 101, 10):
                rpms = measure(percent)
                up.append((percent, rpms))
                show(percent, rpms, columns)
                if all(rpms[fan] for fan in stopped):
                    break
        done = True
    except KeyboardInterrupt:
        print("\nAbgebrochen.")
    finally:
        if original_mode not in (None, 1):
            output.set_enable(original_mode)
        else:
            write_value(output.path, original_pwm)
        print("Ursprünglicher Zustand wiederhergestellt.")
    if not done:
        return 130
    print_test_summary(name, down, up, columns)
    return 0


def print_test_summary(name, down, up, columns):
    print()
    if not columns:
        print("Keine Drehzahlsensoren vorhanden – ob sich der CPU-Lüfter verändert hat, "
              "lässt sich nur durch Hinsehen oder Hinhören feststellen.")
        return
    full, lowest = down[0][1], down[-1][1]
    controlled = [fan for fan in columns
                  if full[fan] and lowest[fan] is not None and lowest[fan] < 0.7 * full[fan]]
    if not controlled:
        print(f"Kein Lüfter hat auf {name} reagiert – bitte einen anderen PWM-Ausgang testen. "
              "Hängt der Lüfter am Mainboard und ist es ein 4-Pin-PWM-Lüfter?")
        return
    min_pwm = start_pwm = 0
    for fan in controlled:
        if lowest[fan]:
            print(f"→ {name} steuert {fan}: {full[fan]:.0f} U/min bei 100 %, "
                  f"bei 0 % noch {lowest[fan]:.0f} U/min (der Lüfter bleibt nicht stehen)")
            continue
        lowest_running = min(percent for percent, rpms in down if rpms[fan])
        start = next((percent for percent, rpms in up if rpms[fan]), None)
        print(f"→ {name} steuert {fan}: {full[fan]:.0f} U/min bei 100 %, läuft bis {lowest_running} %, "
              f"darunter bleibt er stehen" + (f"; startet ab {start} % wieder" if start else ""))
        min_pwm = max(min_pwm, lowest_running + 10)
        start_pwm = max(start_pwm, (start or lowest_running) + 10)
    print("\nVorschlag für /etc/cpu-fancontrol.conf:")
    print(f"  pwm = {name}")
    print(f"  fan = {controlled[0]}")
    if min_pwm:
        print(f"  min_pwm = {min(min_pwm, 100)}")
        print(f"  start_pwm = {min(max(start_pwm, min_pwm), 100)}")


