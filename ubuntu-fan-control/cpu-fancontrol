class LogFormatter(logging.Formatter):
    """Unter systemd mit Syslog-Priorität für journald, sonst lesbar fürs Terminal."""

    PRIORITIES = {logging.DEBUG: 7, logging.INFO: 6, logging.WARNING: 4, logging.ERROR: 3, logging.CRITICAL: 2}
    LEVELS = {logging.DEBUG: "Debug: ", logging.WARNING: "Warnung: ", logging.ERROR: "Fehler: ",
              logging.CRITICAL: "Kritisch: "}

    def __init__(self, journal, timestamps):
        super().__init__()
        self.journal = journal
        self.timestamps = timestamps

    def format(self, record):
        message = record.getMessage()
        if self.journal:
            return f"<{self.PRIORITIES.get(record.levelno, 6)}>{message}"
        prefix = time.strftime("%H:%M:%S ") if self.timestamps else ""
        return f"{prefix}{self.LEVELS.get(record.levelno, '')}{message}"


def stderr_is_journal():
    try:
        dev, ino = (int(x) for x in os.environ.get("JOURNAL_STREAM", "").split(":"))
        st = os.fstat(sys.stderr.fileno())
    except (ValueError, OSError):
        return False
    return (st.st_dev, st.st_ino) == (dev, ino)


def setup_logging(verbose, timestamps):
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(LogFormatter(stderr_is_journal(), timestamps))
    log.addHandler(handler)
    log.setLevel(logging.DEBUG if verbose else logging.INFO)


def build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("-c", "--config", default=DEFAULT_CONFIG,
                        help=f"Konfigurationsdatei (Standard: {DEFAULT_CONFIG})")
    common.add_argument("--state-file", default=DEFAULT_STATE_FILE, help=argparse.SUPPRESS)
    common.add_argument("-v", "--verbose", action="store_true", help="ausführliche Ausgabe")

    parser = argparse.ArgumentParser(prog="cpu-fancontrol",
                                     description="Temperaturgeführte CPU-Lüftersteuerung über hwmon/PWM.")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sub = parser.add_subparsers(dest="command", metavar="BEFEHL")
    sub.required = True

    p = sub.add_parser("list", parents=[common], help="Sensoren, Lüfter und PWM-Ausgänge anzeigen")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("test", parents=[common], help="PWM-Ausgang durchfahren, um den zugehörigen Lüfter zu finden")
    p.add_argument("pwm", help="PWM-Ausgang, z.B. nct6798/pwm2")
    p.add_argument("--delay", type=int, default=5, help="Sekunden je Stufe (Standard: 5)")
    p.add_argument("--max-temp", type=float, default=80, help="Abbruch ab dieser CPU-Temperatur in °C (Standard: 80)")
    p.set_defaults(func=cmd_test)

    p = sub.add_parser("check", parents=[common], help="Konfiguration prüfen und aktuelle Werte anzeigen")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("run", parents=[common], help="Lüftersteuerung starten")
    p.add_argument("--dry-run", action="store_true", help="nur berechnen und loggen, nichts schreiben")
    p.set_defaults(func=cmd_run)

    p = sub.add_parser("restore", parents=[common], help="Lüfter wieder an das Mainboard übergeben")
    p.set_defaults(func=cmd_restore)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    setup_logging(args.verbose, timestamps=args.command == "run")
    try:
        return args.func(args)
    except FanControlError as exc:
        log.error("%s", exc)
        return 2
    except PermissionError as exc:
        log.error("Keine Berechtigung (%s) – bitte mit sudo ausführen", exc)
        return 1
    except OSError as exc:
        log.error("%s", exc)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
