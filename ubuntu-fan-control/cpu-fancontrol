def fmt_temp(value):
    return "–" if value is None else f"{value:.1f} °C"


def fmt_rpm(value):
    return "–" if value is None else f"{int(value)} U/min"


def fmt_pwm(raw):
    return "–" if raw is None else f"{int(raw)} ({raw_to_percent(raw):.0f} %)"


def mode_text(mode):
    if mode is None:
        return "–"
    return {0: "0 (volle Drehzahl)", 1: "1 (manuell)"}.get(mode, f"{mode} (automatisch)")


def safe_mode(output):
    try:
        return output.read_enable()
    except (OSError, ValueError):
        return None


def cmd_list(args):
    chips = discover_chips()
    if not chips:
        print("Keine hwmon-Geräte gefunden.\n")
        print(DRIVER_HINT)
        return 1
    pwm_count = 0
    for chip in chips:
        device = f", Gerät {chip.device}" if chip.device and chip.device != chip.ident else ""
        print(f"{chip.ident}  ({chip.hwmon}{device})")
        rows = []
        for num in chip.numbers("temp"):
            rows.append((f"temp{num}", fmt_temp(read_number(chip.attr_path("temp", num), 1000)), chip.label("temp", num)))
        for num in chip.numbers("fan"):
            rows.append((f"fan{num}", fmt_rpm(read_number(chip.attr_path("fan", num))), chip.label("fan", num)))
        for num in chip.numbers("pwm"):
            output = PwmOutput("", chip.attr_path("pwm", num))
            rows.append((f"pwm{num}", fmt_pwm(read_number(output.path)), f"Betriebsart {mode_text(safe_mode(output))}"))
            pwm_count += 1
        for attr, value, info in rows:
            print(f"  {chip.ident + '/' + attr:<28} {value:>14}  {info}")
        print()
    if pwm_count:
        print("CPU-Lüfter finden:  sudo cpu-fancontrol test <chip>/pwmN")
    else:
        print("Es wurden keine PWM-Ausgänge gefunden.\n")
        print(DRIVER_HINT)
    return 0


def cmd_check(args):
    config = load_config(args.config)
    controllers = build_controllers(config, discover_chips())
    print(f"Konfiguration {args.config} ist gültig "
          f"(Intervall {config.interval:g} s, beim Beenden: {config.on_exit}).")
    for controller in controllers:
        cfg, output = controller.cfg, controller.output
        print(f"\n[fan:{controller.name}]")
        for sensor in controller.sensors:
            print(f"  Sensor     {sensor.name:<24} {fmt_temp(read_number(sensor.path, 1000))}")
        print(f"  PWM        {output.name:<24} {fmt_pwm(read_number(output.path))}, "
              f"Betriebsart {mode_text(safe_mode(output))}")
        if not os.access(output.path, os.W_OK):
            print("             (kein Schreibzugriff – der Dienst muss als root laufen)")
        if controller.fan_sensor:
            print(f"  Drehzahl   {controller.fan_sensor.name:<24} {fmt_rpm(read_number(controller.fan_sensor.path))}")
        print("  Kennlinie  " + ", ".join(f"{t:g} °C → {p:g} %" for t, p in cfg.curve))
        print(f"  Grenzen    min {cfg.min_pwm:g} %, Anlauf {cfg.start_pwm:g} %, "
              f"Hysterese {cfg.hysteresis:g} °C, kritisch ab {cfg.critical_temp:g} °C")
