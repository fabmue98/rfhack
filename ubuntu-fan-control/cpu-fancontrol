class FanController:
    """Regelt einen PWM-Ausgang anhand von Temperatur und Kennlinie."""

    def __init__(self, cfg, output, sensors, fan_sensor=None, history_length=1800):
        self.cfg = cfg
        self.name = cfg.name
        self.output = output
        self.sensors = sensors
        self.fan_sensor = fan_sensor
        self.history = deque(maxlen=cfg.average)
        self.samples = deque(maxlen=history_length)  # Verlauf für die Weboberfläche
        self.level = None          # Wert auf der Kennlinie (vor min_pwm/start_pwm)
        self.last_output = None    # zuletzt ausgegebene Drehzahl in %
        self.logged_output = None
        self.temp = None
        self.average_temp = None
        self.rpm = None
        self.sensor_failed = False
        self.critical = False
        self.stall_count = 0

    def describe(self):
        return f"[{self.name}] {self.output.name} nach {', '.join(s.name for s in self.sensors)}"

    def apply_settings(self, cfg):
        """Übernimmt geänderte Einstellungen im laufenden Betrieb."""
        self.cfg = cfg
        if self.history.maxlen != cfg.average:
            self.history = deque(self.history, maxlen=cfg.average)

    def state(self):
        if self.sensor_failed:
            return "sensor"
        if self.critical:
            return "critical"
        if self.stall_count >= STALL_CYCLES:
            return "stall"
        return "ok"

    def snapshot(self, since=0.0):
        """Aktueller Zustand für die Weboberfläche, Verlauf ab Zeitpunkt `since`."""
        return {
            "name": self.name,
            "pwm": self.output.name,
            "sensors": [sensor.name for sensor in self.sensors],
            "fan": self.fan_sensor.name if self.fan_sensor else None,
            "temp": None if self.temp is None else round(self.temp, 1),
            "average": None if self.average_temp is None else round(self.average_temp, 1),
            "percent": None if self.last_output is None else round(self.last_output, 1),
            "rpm": self.rpm,
            "state": self.state(),
            "settings": {"curve": [list(point) for point in self.cfg.curve],
                         **{key: getattr(self.cfg, key) for key in FAN_LIMITS}},
            "samples": [sample for sample in self.samples if sample[0] > since],
        }

    def compute(self):
        """Berechnet die neue Drehzahl in Prozent."""
        cfg = self.cfg
        try:
            temp = max(sensor.read() for sensor in self.sensors)
        except (OSError, ValueError) as exc:
            if not self.sensor_failed:
                log.error("[%s] Temperatur nicht lesbar (%s) – Lüfter auf 100 %%", self.name, exc)
                self.sensor_failed = True
            self.temp = self.average_temp = None
            self.history.clear()
            self.level = 100.0
            return 100.0
        if self.sensor_failed:
            log.info("[%s] Temperatursensor wieder lesbar", self.name)
            self.sensor_failed = False
        self.temp = temp
        self.history.append(temp)
        self.average_temp = average = sum(self.history) / len(self.history)

        # Kritische Temperatur: sofort volle Drehzahl, ohne Mittelwertbildung
        if temp >= cfg.critical_temp and not self.critical:
            log.warning("[%s] Kritische Temperatur %.1f °C – Lüfter auf 100 %%", self.name, temp)
            self.critical = True
        elif self.critical and temp < cfg.critical_temp - cfg.hysteresis:
            log.info("[%s] Temperatur wieder unter %.0f °C", self.name, cfg.critical_temp - cfg.hysteresis)
            self.critical = False
        if self.critical:
            self.level = 100.0
            return 100.0

        rising = interpolate(cfg.curve, average)
        falling = interpolate(cfg.curve, average + cfg.hysteresis)
        if self.level is None or rising > self.level:
            # Hochregeln sofort
            self.level = rising
        elif falling < self.level:
            # Runterregeln erst nach Ablauf der Hysterese und gebremst
            self.level = max(falling, self.level - cfg.ramp_down_step)
        return self.limit(self.level)

    def limit(self, level):
        """Wendet Mindest- und Anlaufdrehzahl an."""
        if level <= 0:
            return 0.0
        percent = max(level, self.cfg.min_pwm)
        if self.last_output == 0:
            # Lüfter steht: mit Anlaufdrehzahl anschieben
            percent = max(percent, self.cfg.start_pwm)
        return min(percent, 100.0)

    def step(self, dry_run=False):
        percent = self.compute()
        if not dry_run:
            mode = self.output.set_manual()
            if mode not in (None, 1):
                log.warning("[%s] Betriebsart von %s wurde extern auf %s gestellt – übernehme wieder",
                            self.name, self.output.name, mode)
            self.output.write_percent(percent)
        self.check_fan(percent, dry_run)
        self.last_output = percent
        self.log_change(percent)
        temp = None if self.temp is None else round(self.temp, 1)
        self.samples.append((round(time.time(), 1), temp, round(percent, 1), self.rpm))
        return percent

    def check_fan(self, percent, dry_run):
        if self.fan_sensor is None:
            return
        try:
            self.rpm = int(self.fan_sensor.read())
        except (OSError, ValueError):
            self.rpm = None
            return
        if not dry_run and percent > 0 and self.last_output and self.rpm == 0:
            self.stall_count += 1
            if self.stall_count == STALL_CYCLES:
                log.warning("[%s] %s meldet 0 U/min bei %.0f %% – steht der Lüfter? "
                            "(min_pwm zu niedrig oder Lüfter blockiert/defekt)",
                            self.name, self.fan_sensor.name, percent)
        else:
            if self.stall_count >= STALL_CYCLES and self.rpm:
                log.info("[%s] Lüfter dreht wieder (%d U/min)", self.name, self.rpm)
            self.stall_count = 0

    def log_change(self, percent):
        last = self.logged_output
        temp = "Temperatur unbekannt" if self.temp is None else f"{self.temp:.1f} °C"
        rpm = "" if self.rpm is None else f" ({self.rpm} U/min)"
        changed = (last is None or abs(percent - last) >= LOG_STEP
                   or (percent == 0) != (last == 0) or (percent == 100) != (last == 100))
        log.log(logging.INFO if changed else logging.DEBUG, "[%s] %s → Lüfter %.0f %%%s", self.name, temp, percent, rpm)
        if changed:
            self.logged_output = percent


def build_controllers(config, chips):
    controllers, used = [], {}
    for fan in config.fans:
        pwm_name, pwm_path = resolve(chips, fan.pwm, "pwm")
        if pwm_path in used:
            raise FanControlError(f"{pwm_name} ist in [fan:{used[pwm_path]}] und [fan:{fan.name}] eingetragen")
        used[pwm_path] = fan.name
        sensors = []
        for spec in fan.sensors:
            if spec.lower() == "auto":
                sensors.extend(auto_cpu_sensors(chips))
            else:
                sensors.append(Sensor(*resolve(chips, spec, "temp"), divisor=1000, plausible=TEMP_PLAUSIBLE))
        fan_sensor = Sensor(*resolve(chips, fan.fan, "fan")) if fan.fan else None
        controllers.append(FanController(fan, PwmOutput(pwm_name, pwm_path), sensors, fan_sensor,
                                         history_length=int(HISTORY_SECONDS / config.interval) + 1))
    return controllers


def wait_for_devices(config, timeout):
    """Beim Booten wird der Sensortreiber eventuell erst später geladen – kurz warten."""
    deadline = time.monotonic() + timeout
    warned = False
    while True:
        try:
            return build_controllers(config, discover_chips())
        except DeviceNotFound as exc:
            if time.monotonic() >= deadline:
                raise
            if not warned:
                log.warning("%s – warte bis zu %d s auf den Treiber", exc, timeout)
                warned = True
            time.sleep(2)


# ---------------------------------------------------------------------------
# Übernahme und Rückgabe der Lüfter
#
# Vor dem Umschalten auf manuelle Steuerung wird der ursprüngliche Zustand in
# einer Statusdatei unter /run gesichert. Beim Beenden – oder nach einem
# Absturz per "cpu-fancontrol restore" (ExecStopPost im systemd-Dienst) – wird
# daraus die Steuerung an das Mainboard zurückgegeben.
# ---------------------------------------------------------------------------

def acquire_lock(state_file):
    """Verhindert, dass zwei Instanzen gleichzeitig dieselben Lüfter steuern.
    Die Sperre bleibt bis zum Prozessende bestehen."""
    fd = os.open(f"{state_file}.lock", os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise FanControlError("cpu-fancontrol steuert die Lüfter bereits (Dienst aktiv?) – "
                              "erst beenden: sudo systemctl stop cpu-fancontrol")
    return fd


def load_state(path):
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        log.error("Statusdatei %s nicht lesbar: %s", path, exc)
        return None


def save_state(path, state):
    tmp = f"{path}.tmp"
    with open(tmp, "w") as f:
        json.dump(state, f, indent=2)
    os.replace(tmp, path)


def restore_outputs(state):
    """Gibt die Lüfter an das Mainboard zurück bzw. setzt sie auf 100 %."""
    ok = True
    on_exit = state.get("on_exit", "restore")
    for path, original in state.get("outputs", {}).items():
        output = PwmOutput(original.get("name", path), path)
        enable = original.get("enable")
        try:
            if on_exit == "restore" and enable not in (None, 1):
                output.set_enable(enable)
                log.info("%s: Steuerung an das Mainboard zurückgegeben (pwm_enable=%s)", output.name, enable)
            else:
                # Gewünscht oder vorher schon manuell gesteuert: sicherheitshalber volle Drehzahl
                output.set_manual()
                output.write_percent(100)
                log.info("%s: Lüfter auf 100 %% gesetzt", output.name)
        except OSError as exc:
            log.error("%s: Zurücksetzen fehlgeschlagen: %s", output.name, exc)
            ok = False
    return ok


def take_control(controllers, on_exit, state_file):
    previous = load_state(state_file) or {}
    leftovers = dict(previous.get("outputs", {}))
    if leftovers:
        log.warning("Vorherige Instanz wurde nicht sauber beendet – übernehme deren gesicherten Ausgangszustand")
    outputs = {}
    for controller in controllers:
        output = controller.output
        outputs[str(output.path)] = leftovers.pop(str(output.path), None) or {
            "name": output.name, "pwm": output.read(), "enable": output.read_enable()}
    if leftovers:
        # Ausgänge, die laut neuer Konfiguration nicht mehr geregelt werden
        restore_outputs({"on_exit": previous.get("on_exit", on_exit), "outputs": leftovers})
    save_state(state_file, {"on_exit": on_exit, "outputs": outputs})
    for controller in controllers:
        controller.last_output = raw_to_percent(controller.output.read())
        controller.output.set_manual()


def release_control(state_file):
    """Liefert None, wenn nichts zurückzugeben war, sonst ob alles geklappt hat."""
    state = load_state(state_file)
    if state is None:
        return None
    ok = restore_outputs(state)
    try:
        os.remove(state_file)
    except FileNotFoundError:
        pass
    return ok


# ---------------------------------------------------------------------------
# Weboberfläche
#
# Ein kleiner HTTP-Server im Dienst liefert die Oberfläche (web/index.html)
# und eine JSON-API. Er lauscht standardmäßig nur auf 127.0.0.1; von außen ist
# er über den Reverse-Proxy des vorhandenen Webservers erreichbar, z.B. unter
# http://<server>/fan/. Die Lüftersteuerung läuft auch, wenn er nicht startet.
# ---------------------------------------------------------------------------

def hash_password(password):
    salt = os.urandom(16)
    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, PBKDF2_ROUNDS)
    return f"pbkdf2_sha256${PBKDF2_ROUNDS}${salt.hex()}${digest.hex()}"


def check_password(password, stored):
    try:
        _, rounds, salt, digest = stored.split("$")
        test = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt), int(rounds))
    except ValueError:
        return False
    return hmac.compare_digest(test.hex(), digest)


def is_number(value):
    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)


def settings_from_request(payload):
    """Wandelt die Einstellungen aus einer Web-Anfrage in Konfigurationstext um."""
    values = {}
    if "curve" in payload:
        curve = payload["curve"]
        if not (isinstance(curve, list) and 1 <= len(curve) <= MAX_CURVE_POINTS
                and all(isinstance(p, list) and len(p) == 2 and all(is_number(v) for v in p) for p in curve)):
            raise FanControlError(f"Kennlinie: erwartet 1 bis {MAX_CURVE_POINTS} Punkte [Temperatur, Prozent]")
        values["curve"] = format_curve(curve)
    for key in FAN_LIMITS:
        if key in payload:
            if not is_number(payload[key]):
                raise FanControlError(f"{key}: Zahl erwartet")
            values[key] = f"{payload[key]:g}"
    return values


class App:
    """Gemeinsamer Zustand von Regelschleife und Weboberfläche."""

    def __init__(self, config, controllers, config_path, dry_run=False):
        self.config = config
        self.controllers = controllers
        self.config_path = config_path
        self.dry_run = dry_run
        self.started = round(time.time(), 1)
        self.lock = threading.Lock()        # Regelschleife <-> Webzugriffe
        self.write_lock = threading.Lock()  # serialisiert Änderungen an der Konfigurationsdatei

    def status(self, since=0.0):
        with self.lock:
            fans = [controller.snapshot(since) for controller in self.controllers]
        return {
            "version": VERSION,
            "host": socket.gethostname(),
            "time": round(time.time(), 1),
            "started": self.started,
            "interval": self.config.interval,
            "history": HISTORY_SECONDS,
            "dry_run": self.dry_run,
            "limits": {key: list(limits) for key, limits in FAN_LIMITS.items()},
            "fans": fans,
        }

    def update_settings(self, payload):
        """Prüft neue Einstellungen, schreibt sie in die Konfiguration und übernimmt sie sofort."""
        if not isinstance(payload, dict):
            raise FanControlError("Ungültige Anfrage")
        controller = next((c for c in self.controllers if c.name == payload.get("fan")), None)
        if controller is None:
            raise FanControlError(f"Unbekannter Lüfter '{payload.get('fan')}'")
        requested = settings_from_request(payload)
        with self.write_lock:
            current = fan_config_values(controller.cfg)
            changed = {key: value for key, value in requested.items() if value != current[key]}
            if changed:
                parse_fan(controller.name, {**current, **changed})  # prüft vor dem Schreiben
                with open(self.config_path, encoding="utf-8") as f:
                    backup = f.read()
                update_config_file(self.config_path, f"fan:{controller.name}", changed)
                try:
                    config = load_config(self.config_path)
                    new_cfg = next(fan for fan in config.fans if fan.name == controller.name)
                except (FanControlError, StopIteration) as exc:
                    write_file_atomic(self.config_path, backup)
                    raise FanControlError(f"Konfiguration konnte nicht gespeichert werden: {exc}")
            with self.lock:
                if changed:
                    controller.apply_settings(new_cfg)
                snapshot = controller.snapshot(since=math.inf)
        if changed:
            log.info("[%s] Über die Weboberfläche geändert: %s", controller.name,
                     ", ".join(f"{key} = {value}" for key, value in changed.items()))
        return snapshot


class WebHandler(http.server.BaseHTTPRequestHandler):
    server_version = f"cpu-fancontrol/{VERSION}"
    sys_version = ""

    def log_message(self, fmt, *args):
        log.debug("Web %s: %s", self.address_string(), fmt % args)

    def do_GET(self):
        path = self.route()
        if path is None:
            return
        if path in ("/", "/index.html"):
            self.send_page()
        elif path == "/api/status":
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            try:
                since = float(query.get("since", ["0"])[0])
            except ValueError:
                since = 0.0
            self.send_json(200, self.server.app.status(since))
        else:
            self.send_json(404, {"error": "Nicht gefunden"})

    def do_POST(self):
        path = self.route()
        if path is None:
            return
        if path != "/api/settings":
            return self.send_json(404, {"error": "Nicht gefunden"})
        # Nur JSON annehmen: fremde Webseiten können das nicht ohne CORS-Freigabe senden
        if self.headers.get_content_type() != "application/json":
            return self.send_json(415, {"error": "Content-Type application/json erwartet"})
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            length = -1
        if not 0 < length <= 65536:
            return self.send_json(400, {"error": "Ungültige Anfrage"})
        try:
            payload = json.loads(self.rfile.read(length))
        except ValueError:
            return self.send_json(400, {"error": "Ungültiges JSON"})
        try:
            fan = self.server.app.update_settings(payload)
        except FanControlError as exc:
            return self.send_json(400, {"error": str(exc)})
        self.send_json(200, {"ok": True, "fan": fan})

    def route(self):
        """Prüft das Passwort und entfernt den Basispfad (z.B. /fan) aus der URL."""
        if not self.authorized():
            self.send_json(401, {"error": "Anmeldung erforderlich"},
                           {"WWW-Authenticate": 'Basic realm="Lüftersteuerung", charset="UTF-8"'})
            return None
        path = urllib.parse.urlsplit(self.path).path
        base = self.server.app.config.web.path
        if base and path == base:
            self.send_response(301)
            self.send_header("Location", base + "/")
            self.send_header("Content-Length", "0")
            self.end_headers()
            return None
        if base and path.startswith(base + "/"):
            path = path[len(base):]
        return path

    def authorized(self):
        stored = self.server.app.config.web.password_hash
        if not stored:
            return True
        header = self.headers.get("Authorization", "")
        if header in self.server.verified:
            return True
        if not header.startswith("Basic "):
            return False
        try:
            password = base64.b64decode(header[6:]).decode("utf-8").partition(":")[2]
        except (ValueError, UnicodeDecodeError):
            return False
        if not check_password(password, stored):
            log.warning("Weboberfläche: falsches Passwort von %s", self.address_string())
            return False
        if len(self.server.verified) > 100:
            self.server.verified.clear()
        self.server.verified.add(header)
        return True

    def send_page(self):
        page = next((p for p in UI_FILES if p.is_file()), None)
        if page is None:
            return self.send_json(500, {"error": "web/index.html nicht gefunden – install.sh erneut ausführen"})
        body = page.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; script-src 'self' 'unsafe-inline'; "
                         "style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self'")
        self.send_security_headers()
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_json(self, code, data, headers=None):
        body = json.dumps(data, ensure_ascii=False, allow_nan=False).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        for name, value in (headers or {}).items():
            self.send_header(name, value)
        self.send_security_headers()
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def send_security_headers(self):
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "SAMEORIGIN")
        self.send_header("Referrer-Policy", "no-referrer")


class WebServer(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, app):
        web = app.config.web
        self.app = app
        self.verified = set()  # bereits geprüfte Authorization-Header
        self.address_family = socket.AF_INET6 if ":" in web.listen else socket.AF_INET
        super().__init__((web.listen, web.port), WebHandler)


def start_web(app):
    web = app.config.web
    if not web.enabled:
        return None
    try:
        server = WebServer(app)
    except OSError as exc:
        log.error("Weboberfläche konnte nicht auf %s:%d starten (%s) – die Lüftersteuerung läuft trotzdem",
                  web.listen, web.port, exc)
        return None
    threading.Thread(target=server.serve_forever, name="web", daemon=True).start()
    host = f"[{web.listen}]" if ":" in web.listen else web.listen
    log.info("Weboberfläche auf http://%s:%d%s/%s", host, server.server_address[1], web.path,
             "" if web.password_hash else " (ohne Passwort)")
    if not any(p.is_file() for p in UI_FILES):
        log.warning("Weboberfläche: index.html nicht gefunden – install.sh erneut ausführen")
    return server


