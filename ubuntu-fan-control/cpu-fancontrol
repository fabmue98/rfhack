# Für Tests lässt sich ein nachgebildeter sysfs-Baum unterschieben.
HWMON_ROOT = os.environ.get("CPU_FANCONTROL_HWMON_ROOT", "/sys/class/hwmon")

PWM_MAX = 255
CPU_CHIPS = ("coretemp", "k10temp", "zenpower", "cpu_thermal")
TEMP_PLAUSIBLE = (-20.0, 150.0)  # Werte außerhalb gelten als Sensorfehler
STALL_CYCLES = 3                 # Messungen mit 0 U/min, bevor gewarnt wird
LOG_STEP = 10                    # Drehzahländerungen ab so vielen % ins Log schreiben
DEVICE_WAIT = 30                 # Sekunden, die beim Start auf Treiber gewartet wird
TEST_STEPS = (100, 75, 50, 40, 30, 20, 10, 0)

GENERAL_DEFAULTS = {"interval": "2", "on_exit": "restore"}
FAN_DEFAULTS = {
    "pwm": "",
    "sensors": "",
    "fan": "",
    "curve": "40:25, 55:40, 70:70, 80:100",
    "min_pwm": "20",
    "start_pwm": "40",
    "hysteresis": "3",
    "ramp_down_step": "5",
    "average": "3",
    "critical_temp": "85",
}
