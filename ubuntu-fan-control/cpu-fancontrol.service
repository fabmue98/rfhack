[Unit]
Description=CPU-Lüftersteuerung (cpu-fancontrol)
# Sensortreiber (z.B. nct6775, it87) müssen vorher geladen sein
After=systemd-modules-load.service lm-sensors.service network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/cpu-fancontrol run
# Gibt die Lüfter auch nach einem Absturz wieder an das Mainboard zurück
ExecStopPost=/usr/local/sbin/cpu-fancontrol restore
Restart=on-failure
RestartSec=5
# Exit-Code 2 = Konfigurationsfehler: nicht endlos neu starten
RestartPreventExitStatus=2

# Härtung. Benötigt werden weiterhin: Schreibzugriff auf /sys (Lüfter), /run
# (Statusdatei) und /etc/cpu-fancontrol.conf (Speichern aus der Weboberfläche)
# sowie ein lokaler TCP-Port für die Weboberfläche.
NoNewPrivileges=yes
ProtectSystem=yes
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
